#==============================================================
# System
#==============================================================
USE_C = T
TERMINAL_WIDTH = 128
#==============================================================
# Directories
#==============================================================
SPRINGDIR = $(TOPSRCDIR)/SPRING

SPRINGLIBDIR        = $(SPRINGDIR)/lib
SPRINGLIBDIR_CONST  = $(SPRINGLIBDIR)/lib_const
SPRINGLIBDIR_BASE   = $(SPRINGLIBDIR)/lib_base
SPRINGLIBDIR_TIME   = $(SPRINGLIBDIR)/lib_time
SPRINGLIBDIR_LOG    = $(SPRINGLIBDIR)/lib_log
SPRINGLIBDIR_UTIL   = $(SPRINGLIBDIR)/lib_util
SPRINGLIBDIR_RANDOM = $(SPRINGLIBDIR)/lib_random
SPRINGLIBDIR_ARRAY  = $(SPRINGLIBDIR)/lib_array
SPRINGLIBDIR_MATH   = $(SPRINGLIBDIR)/lib_math
SPRINGLIBDIR_STATS  = $(SPRINGLIBDIR)/lib_stats
SPRINGLIBDIR_PROJ   = $(SPRINGLIBDIR)/lib_proj
SPRINGLIBDIR_IO     = $(SPRINGLIBDIR)/lib_io
SPRINGLIBDIR_PNG    = $(SPRINGLIBDIR)/lib_png
SPRINGMODDIR = $(SPRINGLIBDIR)/mod

SPRINGCMNDIR = $(SPRINGDIR)/cmn
SPRINGCMNDIR1 = $(SPRINGCMNDIR)/1
SPRINGCMNDIR2 = $(SPRINGCMNDIR)/2
SPRINGCMNDIR3 = $(SPRINGCMNDIR)/3
#==============================================================
# Library
#==============================================================
SPRINGLIB = $(SPRINGLIBDIR)/lib.a
#==============================================================
# Include system dependency
#==============================================================
include $(TOPSRCDIR)/sysdep/Makedef.$(SPRING_SYS)
#==============================================================
# Set compile options
#==============================================================
ifeq ($(SPRING_DEBUG), T)
  FCFLAGS = $(FCFLAGS_DEBUG)
  CCFLAGS = $(CCFLAGS_DEBUG)
else
  FCFLAGS = $(FCFLAGS_FAST)
  CCFLAGS = $(CCFLAGS_FAST)
endif

ifeq ($(USE_C), T)
  FOPT_USE_C = -DUSE_C
else
  ifdef TERMINAL_WIDTH
    FOPT_TERMINAL_WIDTH = -DTERMINAL_WIDTH=$(TERMINAL_WIDTH)
  endif
endif
